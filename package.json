{
  "name": "@lieshoucloud/admin-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "猎手云 B 端管理后台（Vite 6 + React 19）· 端自身最小骨架（零上游共享依赖）。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2",
    "antd": "5.22.0",
    "@ant-design/icons": "~5.5.1",
    "@ant-design/pro-components": "^2.8.0",
    "dayjs": "~1.11.13",
    "@lieshoucloud/contract-api": "workspace:*",
    "@lieshoucloud/contract-config": "workspace:*",
    "@lieshoucloud/contract-types": "workspace:*",
    "@lieshoucloud/core-web": "workspace:*",
    "@lieshoucloud/i18n": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "~22.9.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}

{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lieshoucloud/contract-api": [
        "open/contract-api/src"
      ],
      "@lieshoucloud/contract-config": [
        "open/contract-config/src"
      ],
      "@lieshoucloud/contract-types": [
        "open/contract-types/src"
      ],
      "@lieshoucloud/contract-types/*": [
        "open/contract-types/src/*"
      ],
      "@lieshoucloud/core-web": [
        "open/core-web/src"
      ],
      "@lieshoucloud/i18n": [
        "open/i18n/src"
      ],
      "@lieshoucloud/dwjk": [
        "../packages/dwjk/src"
      ],
      "@lieshoucloud/dwjk/*": [
        "../packages/dwjk/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "react-router-dom": [
        "./node_modules/react-router-dom"
      ],
      "antd": [
        "./node_modules/antd"
      ],
      "@ant-design/icons": [
        "./node_modules/@ant-design/icons"
      ],
      "@ant-design/pro-components": [
        "./node_modules/@ant-design/pro-components"
      ],
      "dayjs": [
        "./node_modules/dayjs"
      ],
      "qrcode.react": [
        "./node_modules/qrcode.react"
      ],
      "@lieshoucloud/ui": [
        "open/ui/src"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/config/editions/*.extra.ts"
  ]
}
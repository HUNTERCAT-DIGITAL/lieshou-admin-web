{
  "extends": "./open/contract-config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lieshoucloud/contract-api": ["./open/contract-api/src"],

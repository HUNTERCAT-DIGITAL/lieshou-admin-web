{
  "extends": "./open/contract-config/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lieshoucloud/contract-api": [
        "./open/contract-api/src"
      ],
      "@lieshoucloud/contract-types": [
        "./open/contract-types/src"
      ],
      "@lieshoucloud/ui": [
        "./open/ui/src"
      ],
      "@lieshoucloud/contract-types/business/*": [
        "./open/contract-types/src/business/*.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}

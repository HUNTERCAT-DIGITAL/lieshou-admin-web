{
  "extends": "./open/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lieshoucloud/api-client": ["./open/api-client/src"],
      "@lieshoucloud/types/business/*": ["./open/types/src/business/*.ts"],
      "@lieshoucloud/types": ["./open/types/src"],
      "@lieshoucloud/ui": ["./open/ui/src"],
      "@lieshoucloud/boot": ["../packages/boot/src/index.ts"],
      "@lieshoucloud/boot/*": ["../packages/boot/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
